{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tortilleria-renteria",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "build": {
    "command": "npm run check"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tortilleria-renteria-db",
      "database_id": "ac44058f-141b-4dd0-8cfe-7e7df1aaf67d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://maquinaria-renteria.com"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
