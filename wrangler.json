{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tortilleria-renteria",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tortilleria-renteria-db",
      "database_id": "ac44058f-141b-4dd0-8cfe-7e7df1aaf67d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://tortilleria-renteria.malisil0817.workers.dev"
  }
}
